# ========== 平台凭证（必填，见 API-清单.md 第一节）==========
PLATFORM_BASE_URL=
PLATFORM_TOKEN=
PROJECT_ID=
CANVAS_ID=

# ========== 提示词模型（必填，第二节）==========
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CONCURRENCY=3

# ========== 本地路径（必填，第三节）==========
ASSET_ROOT=D:/AI漫剧
WORK_DIR=D:/AI漫剧/_work

# ========== 可选（第四节）==========
PRICE_PER_IMAGE=0.12
SUBMIT_PARALLEL=3
POLL_INTERVAL=20
POLL_TIMEOUT=2400
ASSET_URL_PREFIX=

# ========== 上传平台（可选，第五节；平台动态下发凭证时留空）==========
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
